{
  "name": "orcode",
  "version": "0.7.0",
  "description": "A local, terminal-based coding agent CLI that runs against any tool-capable model on OpenRouter, with per-workspace cost tracking, explicit approval modes, and a separate compressor model for long context.",
  "keywords": [
    "openrouter",
    "cli",
    "coding-agent",
    "ai-agent",
    "llm",
    "terminal",
    "tui",
    "developer-tools"
  ],
  "homepage": "https://github.com/dkay95/orcode#readme",
  "bugs": {
    "url": "https://github.com/dkay95/orcode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkay95/orcode.git"
  },
  "license": "Apache-2.0",
  "author": "Dogancan Kaya <dogancan.kaya424@gmail.com>",
  "type": "module",
  "bin": {
    "orcode": "./dist/cli.js",
    "routercode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "scripts/install-user.mjs",
    "scripts/check-package.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && npm test",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release-metadata.mjs",
    "test:migration": "node --import tsx --test tests/app-home-migration.test.ts tests/private-store.test.ts tests/private-store-identity-races.test.ts",
    "test:release-regressions": "node --import tsx --test tests/cli.test.ts tests/commands.test.ts tests/openrouter.test.ts tests/models.test.ts tests/session.test.ts tests/attachments.test.ts tests/voice.test.ts tests/agent.test.ts tests/tui.test.ts",
    "test:pty": "node scripts/check-pty.mjs",
    "install:user": "node scripts/install-user.mjs",
    "prepublishOnly": "npm run check && npm run check:package"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@napi-rs/keyring": "1.3.0",
    "@openrouter/agent": "0.8.0",
    "@openrouter/sdk": "0.13.67",
    "chalk": "^5.6.2",
    "fast-glob": "^3.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
