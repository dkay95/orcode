{
  "name": "routercode",
  "version": "0.3.0",
  "description": "A local, approval-aware coding agent CLI powered by OpenRouter.",
  "type": "module",
  "bin": {
    "routercode": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && npm test",
    "install:user": "npm run build && node scripts/install-user.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@napi-rs/keyring": "1.3.0",
    "@openrouter/agent": "0.8.0",
    "chalk": "^5.6.2",
    "fast-glob": "^3.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
